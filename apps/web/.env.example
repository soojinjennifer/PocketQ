# Supabase 프로젝트 URL (Supabase 대시보드 > Project Settings > API)
VITE_SUPABASE_URL=

# Supabase anon(public) API 키 (Supabase 대시보드 > Project Settings > API)
VITE_SUPABASE_ANON_KEY=

# 포켓큐 백엔드(apps/api) 베이스 URL (예: 로컬 개발은 http://localhost:4000)
VITE_API_BASE_URL=

# 도형 시각화 화면(Stage 4, 빌드 시점). 정확히 "true"일 때만 결과 패널에 검증된 그림을 보인다(기본 off — 비워 둔다).
# 서버 FIGURES_ENABLED와의 조합 규칙(서버 on + 웹 off 금지, 켤 때는 웹 → 서버 순서)은 docs/DEPLOYMENT.md 참고.
VITE_FIGURES_ENABLED=
