SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI 호환 게이트웨이. 정확히 runyour일 때만 OPENAI_API_KEY 대신 RUNYOUR_API_KEY로 https://api.runyour.ai/v1에 요청한다
# (AI_PROVIDER=openai 유지, AI_MODEL은 Runyour 모델 ID 예: openai/gpt-6-astra — anthropic/* 모델은 도형 생성 불가). 비우면 OpenAI 직접 호출.
AI_GATEWAY=
RUNYOUR_API_KEY=
CAS_SERVICE_URL=
# 도형 시각화(PRD §4.12 FIG) 플래그. 정확히 true일 때만 on(풀이 단계 표지 요청 + done 뒤 도형 생성 호출·event: figures).
# 비워두면 off = 기존 흐름과 바이트 동일. 운영은 Stage 4 전까지 off(docs/DEPLOYMENT.md).
FIGURES_ENABLED=
# 도형 저장(Stage 5). 정확히 true일 때만 on. supabase/migrations/20261025000000_solution_figures.sql 적용 후에 켠다
# (적용 전에 켜도 컬럼 탐지 실패로 도형 키를 쓰지 않으며 텍스트 저장은 그대로). 적용 뒤 서버 재시작 권장.
FIGURES_PERSIST_ENABLED=
# 이어풀기 결과 저장·마이페이지 재조회(Stage 5). 정확히 true일 때만 on. 20261025000100_resume_solutions.sql 적용 후에 켠다.
RESUME_PERSIST_ENABLED=
PORT=
CORS_ORIGIN=
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
