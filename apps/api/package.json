{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "db:import-curriculum": "tsx --env-file=.env src/infrastructure/curriculum/cli/import-curriculum.ts",
    "db:validate-curriculum": "tsx src/infrastructure/curriculum/cli/validate-curriculum.ts",
    "reference:extract-pilot": "tsx --env-file=.env src/infrastructure/referenceAnalysis/cli/extract-reference-pilot.ts",
    "reference:validate-features": "tsx src/infrastructure/referenceAnalysis/cli/validate-reference-features.ts",
    "exam:ingest-gold-set": "tsx --env-file=.env src/infrastructure/examCalibration/cli/ingest-gold-set.ts",
    "exam:validate-features": "tsx src/infrastructure/examCalibration/cli/validate-exam-features.ts",
    "exam:calibrate-families": "tsx --env-file=.env src/infrastructure/examCalibration/cli/calibrate-problem-families.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "cors": "2.8.6",
    "express": "5.2.1",
    "multer": "2.2.0",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "shared-types": "workspace:*",
    "tsx": "4.23.11",
    "validation": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "^24",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
